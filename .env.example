# ── Spotlyte Super Admin Console ─────────────────────────────
# Copy to .env (apps/api reads it via dotenv; apps/admin-web reads NEXT_PUBLIC_*)

# MongoDB connection string (native driver, db name `spotlyte`)
MONGODB_URI=mongodb://127.0.0.1:27017

# Secret used to sign admin JWTs (httpOnly cookie `spotlyte_admin`)
JWT_SECRET=change-me-in-production

# API port (GraphQL served at POST /graphql)
PORT=4000

# Origin of the admin web app (CORS allow-list, credentials enabled)
WEB_ORIGIN=http://localhost:3000

# GraphQL endpoint the browser hits
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
